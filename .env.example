APP_NAME="Pasan Portfolio"
APP_ENV="development"

# RAG settings
RAG_KNOWLEDGE_DIR="knowledge"
RAG_CHUNK_SIZE="800"
RAG_CHUNK_OVERLAP="160"
RAG_TOP_K="4"

# Security / abuse controls
API_ACCESS_TOKEN=""
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_CONTACT_MAX="5"
RATE_LIMIT_CHAT_MAX="10"

# LLM logging (set REDACT=false in dev to log full content)
LLM_LOG_ENABLED="true"
LLM_LOG_REDACT="true"

# OpenRouter (optional, for AI answers)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_REFERER=""
OPENROUTER_TITLE="Pasan Portfolio"
OPENROUTER_FALLBACK_MODELS=""
OPENROUTER_MAX_RETRIES="2"
OPENROUTER_RETRY_BACKOFF="0.6"

# SMTP configuration (required for /api/contact)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USERNAME="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"

# Email headers
SMTP_FROM="Pasan Portfolio <no-reply@your-domain.com>"
SMTP_TO="you@your-domain.com"

# Transport flags (set one)
# STARTTLS (usually port 587)
SMTP_USE_TLS="true"
# SMTPS/SSL (usually port 465)
SMTP_USE_SSL="false"
SMTP_TIMEOUT_SECONDS="20"
