APP_NAME="Pasan Portfolio"
APP_ENV="development"

# RAG settings
RAG_KNOWLEDGE_DIR="knowledge"
RAG_CHUNK_SIZE="800"
RAG_CHUNK_OVERLAP="160"
RAG_TOP_K="4"

# OpenRouter (optional, for AI answers)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_REFERER=""
OPENROUTER_TITLE="Pasan Portfolio"

# SMTP configuration (required for /api/contact)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USERNAME="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"

# Email headers
SMTP_FROM="Pasan Portfolio <no-reply@your-domain.com>"
SMTP_TO="you@your-domain.com"

# Transport flags (set one)
SMTP_USE_TLS="true"   # STARTTLS (usually port 587)
SMTP_USE_SSL="false"  # SMTPS/SSL (usually port 465)
